<?xml version="1.0" encoding="UTF-8"?>
<!--
    Minimal settings file for the forked Maven invocations of the
    maven-invoker-plugin. It isolates the IT builds from the user's own
    ~/.m2/settings.xml (mirrors, servers, profiles, ...).

    Note: no <localRepository> element on purpose. The maven-invoker-plugin
    always ignores it in this file; the effective local repository is the
    plugin's <localRepositoryPath> parameter (target/local-repo).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
</settings>
